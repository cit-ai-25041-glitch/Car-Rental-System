#include <iostream>
#include <string>
using namespace std;
class Car {
private:
    int id;
    string model;
    double price;
    bool rented;
public:
    Car(int i, string m, double p) {
        id = i; model = m; price = p; rented = false;  }
    ~Car() { cout << "Destroyed: " << model << endl; }
    
    int getId() { return id; }

    void display() {
        cout << id << " - " << model << " - $" << price
             << " - " << (rented ? "Rented" : "Available") << endl;}

    void rentCar(string name, int days) {
        if (rented || days <= 0) {
            cout << "Not available!" << endl;
            return;}
        rented = true;
        cout << "Customer: " << name << "\nTotal: $" << price * days << endl;   }   };

class Customer {
private:
    string name;
public:
    Customer(string n) { name = n; }
    string getName() { return name; }   };

int main() {
    Car cars[4] = {
        {1, "Toyota", 30},
        {2, "Hyundai", 25},
        {3, "BMW", 100},
        {4, "Mercedes", 120} };
    int choice = 0, id, days;
    string name;

    while (choice != 3) {
        cout << "\n1. Show Cars\n2. Rent Car\n3. Exit\nChoice: ";
        cin >> choice;

        if (choice == 1) {
            for (int i = 0; i < 4; i++)
                cars[i].display();
        }
        else if (choice == 2) {
            cout << "Name: "; cin >> name;
            cout << "Car ID: "; cin >> id;
            cout << "Days: "; cin >> days;

            Customer customer(name);
            bool found = false;

            for (int i = 0; i < 4; i++) {
                if (cars[i].getId() == id) {
                    cars[i].rentCar(customer.getName(), days);
                    found = true;
                    break;
                } }
            if (!found) cout << "Car not found!" << endl;
        }
        else if (choice != 3)
            cout << "Invalid choice!" << endl;  }

    return 0;}